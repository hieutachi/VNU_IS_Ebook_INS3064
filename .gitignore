# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.claude/
*.swp
*.swo

# Local archives and rollback snapshots
_archive/
_tools/backups/

# Generated audit output (recreate with the scripts in _tools/)
_tools/*.txt

# One-off audit probes and bootstrap scripts.
# The re-runnable QA scripts have no tmp- prefix.
_tools/tmp-*.js

# Authoring prompts kept out of the published package
Cursor_Prompt_Tao_Ebook.md

# Common generated dependencies and build output
node_modules/
dist/
build/
site/
coverage/
*.log
*.tmp
*.temp

# Lecturer binaries. Large, opaque to diff, and permanent once in git history.
# They stay in OneDrive; the repository keeps only the text sources.
Slide/*.pdf
Slide/*.pptx
Worksheet/**/*.pdf
English/worksheet/*.zip
English/worksheet/**/.screenshots/

# Legacy Python slide generators, superseded by the Node pipeline in _tools/.
# Kept on disk for reference; the tracked generator is create_slides_from_vietnamese.py.
create_all_slides.py
create_remaining_slides.py
create_slides_from_markdown.py
generate_slides_auto.py

# Student-side artefacts that must never be committed with the course package
examples/**/uploads/*
!examples/**/uploads/.gitkeep
**/config.local.php
.env

# AI tooling (local only)
.commandcode/
ClaudeKit-Clean/
